{
  "name": "career-ops",
  "version": "1.37.0",
  "description": "Open-source AI job search that runs locally in your AI coding CLI: scan job portals, evaluate listings into a structured A-H report with a 1-5 score, tailor your CV, track applications",
  "private": true,
  "engines": {
    "node": "^22.13.0 || >=23.4.0"
  },
  "scripts": {
    "resume:yaml:export": "bun resume-yaml.mjs export output/payload-posthog-product-owner.json --resume=resumes-61s",
    "resume:yaml:diff": "bun resume-yaml.mjs apply output/resumes-61s.edit.yml output/payload-posthog-product-owner.json --resume=resumes-61s",
    "resume:yaml:apply": "bun resume-yaml.mjs apply output/resumes-61s.edit.yml output/payload-posthog-product-owner.json --resume=resumes-61s --write && bun run resume:publish",
    "resume:tree": "bun bead-tree.mjs resumes-61s",
    "resume:typecheck": "bun bead-typecheck.mjs resumes-61s output/payload-posthog-product-owner.json",
    "resume:json": "bun bead-resume-json.mjs output/payload-posthog-product-owner.json --resume=resumes-61s > output/resumes-61s.audit.json",
    "resume:publish": "bun bead-resume-json.mjs output/payload-posthog-product-owner.json --resume=resumes-61s --to-bead=brain-3jmjo",
    "resume:pdf:dense": "bun build-cv-html.mjs output/payload-posthog-product-owner.json output/cv-posthog-product-owner-dense.html templates/cv-template.compact.html && node generate-pdf.mjs output/cv-posthog-product-owner-dense.html output/cv-posthog-product-owner-dense.pdf --format=letter --allow-nonchronological",
    "resume:layout": "bun ../resume-docx/layout-check.ts output/cv-posthog-product-owner-mid.pdf",
    "resume:pdf:mid": "bun build-cv-html.mjs output/payload-posthog-product-owner.json output/cv-posthog-product-owner-mid.html templates/cv-template.compact-mid.html && node generate-pdf.mjs output/cv-posthog-product-owner-mid.html output/cv-posthog-product-owner-mid.pdf --format=letter --allow-nonchronological",
    "resume:ts:typecheck": "bun bead-typecheck.mjs resumes-f3m output/payload-tailscale-ai-enablement.json",
    "resume:ts:json": "bun bead-resume-json.mjs output/payload-tailscale-ai-enablement.json --resume=resumes-f3m > output/resumes-f3m.audit.json",
    "resume:ts:pdf": "bun build-cv-html.mjs output/payload-tailscale-ai-enablement.json output/cv-tailscale-ai-enablement-mid.html templates/cv-template.compact-mid.html && node generate-pdf.mjs output/cv-tailscale-ai-enablement-mid.html output/cv-tailscale-ai-enablement-mid.pdf --format=letter --allow-nonchronological",
    "resume:pdf": "bun build-cv-html.mjs output/payload-posthog-product-owner.json output/cv-posthog-product-owner-1page.html && node generate-pdf.mjs output/cv-posthog-product-owner-1page.html output/cv-posthog-product-owner-1page.pdf --format=letter --allow-nonchronological",
    "resume:live": "bun lavish-live.mjs output/payload-posthog-product-owner.json --resume=resumes-61s --port=4388 --host=100.74.138.74 --base= --export-bead=brain-3jmjo --no-open",
    "doctor": "node doctor.mjs",
    "ui": "node scripts/ui-server.mjs",
    "or": "node openrouter-runner.mjs",
    "or:scan": "node openrouter-runner.mjs scan",
    "or:pipeline": "node openrouter-runner.mjs pipeline",
    "or:eval": "node openrouter-runner.mjs evaluate",
    "or:apply": "node openrouter-runner.mjs apply",
    "verify": "node verify-pipeline.mjs",
    "lint": "node scripts/check-syntax.mjs",
    "normalize": "node normalize-statuses.mjs",
    "dedup": "node dedup-tracker.mjs",
    "fix-report-links": "node fix-report-links.mjs",
    "merge": "node merge-tracker.mjs",
    "reconcile": "node reconcile-pipeline.mjs",
    "pdf": "node generate-pdf.mjs",
    "jd:similarity": "node jd-similarity.mjs",
    "img-to-pdf": "node img-to-pdf.mjs",
    "cover-letter": "node generate-cover-letter.mjs --payload",
    "cv:verify-facts": "node verify-cv-facts.mjs",
    "cv:verify-ats": "node verify-ats.mjs",
    "test:cv-visual": "playwright test --config=playwright.cv.config.mjs",
    "test:cv-visual:update": "playwright test --config=playwright.cv.config.mjs --update-snapshots",
    "sync-check": "node cv-sync-check.mjs",
    "update:check": "node update-system.mjs check",
    "update:test": "node updater-migration-tests.mjs",
    "update": "node update-system.mjs apply --confirm",
    "rollback": "node update-system.mjs rollback",
    "liveness": "node check-liveness.mjs",
    "extract": "node browser-extract.mjs",
    "scan:hn": "node scan-hn.mjs",
    "scan": "node scan.mjs",
    "scan:full": "node scan-ats-full.mjs",
    "scan:seeds": "node scan-ats-full.mjs --seeds yc,a16z",
    "scan:yc": "node scan-ats-full.mjs --seeds yc",
    "scan:interamt": "node scan-interamt.mjs",
    "scan:dayforce": "node scan-dayforce.mjs",
    "company:funded": "node company-funded.mjs",
    "validate:portals": "node validate-portals.mjs",
    "verify:portals": "node verify-portals.mjs",
    "tracker": "node tracker.mjs",
    "find": "node find.mjs",
    "patterns": "node analyze-patterns.mjs",
    "keyword-match": "node keyword-match.mjs",
    "calibrate": "node calibrate.mjs",
    "upskill": "node upskill.mjs",
    "career-profile": "node career-profile.mjs",
    "add": "node add-entry.mjs",
    "reposts": "node detect-reposts.mjs",
    "digest": "node weekly-digest.mjs",
    "freshness": "node check-table-freshness.mjs",
    "jd-archive": "node check-jd-archive.mjs",
    "rejection-latency": "node rejection-latency.mjs",
    "invite-match": "node invite-match.mjs",
    "paste-reply": "node paste-reply.mjs",
    "gemini:eval": "node gemini-eval.mjs",
    "ollama:eval": "node ollama-eval.mjs",
    "openai:eval": "node openai-eval.mjs",
    "openai:tailor": "node openai-tailor.mjs",
    "eval:golden": "node eval-golden.mjs",
    "star": "node match-star.mjs",
    "archive": "node archive-posting.mjs",
    "prepare:application": "node prepare-application.mjs",
    "application:init": "node application-artifacts.mjs --init",
    "build:dashboard": "node build-dashboard.mjs",
    "serve:dashboard": "cd dashboard && go run .",
    "postinstall": "node -e \"process.exit(['','0','false'].includes((process.env.PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD||'').toLowerCase())?1:0)\" || npx playwright install chromium || npx playwright install chromium",
    "manifesto": "node manifesto.mjs",
    "resume:ts:sync": "bun resume-yaml.mjs sync-payload output/payload-tailscale-ai-enablement.json --resume=resumes-f3m"
  },
  "keywords": [
    "ai",
    "job-search",
    "claude-code",
    "opencode",
    "career",
    "career-ops",
    "careerops",
    "automation",
    "codex",
    "antigravity",
    "qwen",
    "kimi",
    "copilot",
    "grok",
    "ai-agent-skill"
  ],
  "author": "Santiago Fernández de Valderrama <hi@santifer.io> (https://santifer.io)",
  "homepage": "https://career-ops.org",
  "repository": {
    "type": "git",
    "url": "https://github.com/career-ops-hq/career-ops"
  },
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "dotenv": "^18.0.4",
    "js-yaml": "^5.3.0",
    "playwright": "1.64.0",
    "undici": "^6.28.1"
  }
}
